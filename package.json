{
  "name": "zapsmtp",
  "version": "0.1.1",
  "description": "The official Node.js and TypeScript SDK for the ZapSMTP email API",
  "license": "MIT",
  "homepage": "https://zapsmtp.com/docs/sdks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZapSMTP/zapsmtp-node.git"
  },
  "bugs": "https://github.com/ZapSMTP/zapsmtp-node/issues",
  "keywords": ["email", "smtp", "transactional email", "zapsmtp", "api", "sdk"],
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
